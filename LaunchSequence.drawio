        <mxCell id="grp_cleanup" value="&lt;b&gt;CLEANUP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;fontStyle=0;fontSize=13;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="210" y="710" width="260" height="300" as="geometry"/>
        </mxCell>

        <!-- ===== STATE NODES ===== -->

        <!-- IDLE -->
        <mxCell id="idle" value="&lt;b&gt;IDLE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- RAMPING -->
        <mxCell id="ramping" value="&lt;b&gt;RAMPING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flywheel spin-up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="130" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- LAUNCHING sub-steps -->
        <mxCell id="sub0" value="&lt;b&gt;0&lt;/b&gt;&amp;nbsp; Rotate Carousel to ball N" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="sub1" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Tiny Kicker (seat ball)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="375" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="sub2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Tilt Shooter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="470" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="sub3" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp; Full Kicker (LAUNCH!)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;strokeWidth=1.5;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="565" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="sub4" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp; Reset Tilt + Kicker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="200" height="45" as="geometry"/>
        </mxCell>

        <!-- CLEANUP sub-steps -->
        <mxCell id="clean0" value="&lt;b&gt;0&lt;/b&gt;&amp;nbsp; Home Tilt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="750" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="clean1" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Home Kicker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="840" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="clean2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Reset Carousel &amp;amp; Stop Shooter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="930" width="200" height="45" as="geometry"/>
        </mxCell>

        <!-- DONE -->
        <mxCell id="done" value="&lt;b&gt;DONE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="1070" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- IDLE -> RAMPING -->
        <mxCell id="e_idle_ramp" value="start(velocity, tiltPos)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;" edge="1" source="idle" target="ramping" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- RAMPING -> Sub0 -->
        <mxCell id="e_ramp_s0" value="rampUpDuration (2.0s) elapsed&lt;br&gt;homes tilt + kicker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;" edge="1" source="ramping" target="sub0" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sub0 -> Sub1 -->
        <mxCell id="e_s0_s1" value="defaultStepDelay (1.0s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" source="sub0" target="sub1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sub1 -> Sub2 -->
        <mxCell id="e_s1_s2" value="defaultStepDelay&lt;br&gt;(+0.2s extra for ball 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" source="sub1" target="sub2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sub2 -> Sub3 -->
        <mxCell id="e_s2_s3" value="defaultStepDelay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" source="sub2" target="sub3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sub3 -> Sub4 (ball 0 or 1, go right) -->
        <mxCell id="e_s3_s4" value="balls 0 &amp;amp; 1:&lt;br&gt;tiltToLaunchDelay (1.0s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="sub3" target="sub4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sub4 -> Sub0 (loop back, up and left) -->
        <mxCell id="e_s4_s0" value="ballNumber++&lt;br&gt;defaultStepDelay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="sub4" target="sub0" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="302"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Sub3 -> Clean0 (ball 2, last ball, go down) -->
        <mxCell id="e_s3_c0" value="ball 2 (last):&lt;br&gt;tiltToLaunchDelay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=1;" edge="1" source="sub3" target="clean0" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Clean0 -> Clean1 -->
        <mxCell id="e_c0_c1" value="defaultStepDelay + 0.2s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" source="clean0" target="clean1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Clean1 -> Clean2 -->
        <mxCell id="e_c1_c2" value="defaultStepDelay + 0.5s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" source="clean1" target="clean2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Clean2 -> DONE -->
        <mxCell id="e_c2_done" value="defaultStepDelay + 0.5s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" source="clean2" target="done" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DONE -> IDLE (reset, dashed, wraps left) -->
        <mxCell id="e_done_idle" value="reset()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontStyle=2;dashed=1;dashPattern=8 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="done" target="idle" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="1095"/>
              <mxPoint x="140" y="45"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
