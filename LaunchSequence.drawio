  <diagram id="launch-seq" name="LaunchSequence State Machine">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== GROUP CONTAINERS ===== -->

        <mxCell id="grp_launch" value="&lt;b&gt;LAUNCHING&lt;/b&gt;  (repeats for balls 0, 1, 2)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=10;fontStyle=0;fontSize=13;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
